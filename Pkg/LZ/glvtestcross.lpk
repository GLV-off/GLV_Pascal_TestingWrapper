<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="6">
    <Name Value="GlvTestCross"/>
    <AddToProjectUsesSection Value="True"/>
    <CompilerOptions>
      <Version Value="11"/>
      <SearchPaths>
        <IncludeFiles Value="$(ProjOutDir);../../Src"/>
        <OtherUnitFiles Value="../../Src"/>
        <UnitOutputDirectory Value="../../Out/$(TargetCPU)-$(TargetOS)/$(BuildMode)"/>
      </SearchPaths>
      <Parsing>
        <SyntaxOptions>
          <UseAnsiStrings Value="False"/>
        </SyntaxOptions>
      </Parsing>
      <CodeGeneration>
        <Optimizations>
          <OptimizationLevel Value="0"/>
        </Optimizations>
      </CodeGeneration>
      <Linking>
        <Debugging>
          <DebugInfoType Value="dsDwarf3"/>
        </Debugging>
      </Linking>
      <Other>
        <CustomOptions Value="-dFPUNIT"/>
      </Other>
    </CompilerOptions>
    <Version Major="1"/>
    <Files>
      <Item>
        <Filename Value="../../Src/Glv.Testing.Cross.pas"/>
        <UnitName Value="Glv.Testing.Cross"/>
      </Item>
      <Item>
        <Filename Value="../../Src/Glv.Testing.App.pas"/>
        <UnitName Value="Glv.Testing.App"/>
      </Item>
      <Item>
        <Filename Value="../../Src/Glv.Testing.AppWrapper.pas"/>
        <UnitName Value="Glv.Testing.AppWrapper"/>
      </Item>
      <Item>
        <Filename Value="../../Src/Glv.Testing.FPUnitAppWrapper.pas"/>
        <UnitName Value="Glv.Testing.FPUnitAppWrapper"/>
      </Item>
      <Item>
        <Filename Value="../../Src/Glv.Testing.Assertion.pas"/>
        <UnitName Value="Glv.Testing.Assertion"/>
      </Item>
      <Item>
        <Filename Value="../../Src/Glv.Testing.TestCase.pas"/>
        <UnitName Value="Glv.Testing.TestCase"/>
      </Item>
      <Item>
        <Filename Value="../../Src/Glv.Testing.LighConsoleWriter.pas"/>
        <UnitName Value="Glv.Testing.LighConsoleWriter"/>
      </Item>
    </Files>
    <RequiredPkgs>
      <Item>
        <PackageName Value="fpcunittestrunner"/>
      </Item>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
    </PublishOptions>
  </Package>
</CONFIG>
